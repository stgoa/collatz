import Mathlib

/-!
# Periodic invariant colourings of `3x+d`: the general classification (queue item 1b)

Lane: `claude/lean-lane`. Prose sources: main's
`experiments/viewpoints/V002/invariant_colors.md`, §4 and Appendix ("every
`M`-periodic solution of (1) factors through `g = gcd(M,d)` and is constant on the
orbits of multiplication by 2 and 3 in `Z/gZ`; the converse also holds"), and the
side lane's `sidekick/writeup/D_UNIFORM_AUTOMATIC.md` (same finish for automatic
colourings).

Conventions. `d` is a positive odd integer (`3 ∣ d` is allowed). A colouring
`h : ℕ → α` is `M`-periodic if `h (n + M) = h n` for all `n`, and `3x+d`-invariant
if `h (2n) = h n` for all `n` and `h (3n + d) = h n` for all odd `n > 1`. The colour
type `α` is arbitrary.

Verified in this file (all with the standard axioms):

* `invariant_classification`: an `M`-periodic invariant colouring (`M > 0`) is
  `gcd(M,d)`-periodic and satisfies `h (2n) = h n` and `h (3n) = h n` for every
  `n` — i.e. it factors through `Z/gcd(M,d)Z` and is constant on the classes
  generated by multiplication by `2` and `3` there (`factors_through_zmod` states
  this with an explicit `F : ZMod (gcd M d) → α`);
* `invariant_of_class_function`: conversely, for `g ∣ d`, every `g`-periodic `F`
  with `F (2n) = F n` and `F (3n) = F n` is a `3x+d`-invariant colouring (and
  `M`-periodic for every multiple `M` of `g`, by `period_of_dvd`);
* `period_gcd_six_free`: refinement — if the period is `2^a 3^b M'` with `M'`
  odd, the colouring is already `gcd(M', d)`-periodic (for `3 ∣ d` this is
  stronger than `gcd(M,d)`: `d = 3`, `M = 9` forces a constant);
* `eventually_periodic_invariant`: an eventual period gives the same conclusions
  on the positive integers;
* `control_indicator`: for odd `d` with `3 ∤ d` the indicator of `d ∣ n` is a
  `d`-periodic invariant colouring, nonconstant for `d > 1`
  (`control_five`, `control_sixty_one` are the repository's `3x+5`, `3x+61`
  controls).

Proof route (differs in form from the Appendix, same content): for an odd period
`M ≥ 3` the odd rule extends to **every** `x` (`tri_all`: use the representative
`x + M` or `x + 2M`, whichever is odd); hence `h (6x + d) = h (6x + 2d) = h x`
(`six_rule`); a period `3K` drops to `K` because `6(x+K) + d ≡ 6x + d (mod 3K)`
(`period_div_three`); an even period halves by doubling (`period_half`); and for
`M ≥ 3` coprime to `6` the inverse of `6` modulo `M` turns the two identities into
`h (n + d) = h n` (`period_d_of_coprime`), so `gcd(M, d)` is a period
(`period_gcd`, by the Euclidean algorithm). Nothing here concerns orbits or
convergence; Collatz remains open.
-/

namespace LeanLane
namespace GenPer

variable {α : Type*}

/-! ### Periods -/

theorem pow_two_mul (h : ℕ → α) (hdbl : ∀ n, h (2 * n) = h n) (a n : ℕ) :
    h (2 ^ a * n) = h n := by
  induction a with
  | zero => simp
  | succ a ih => rw [pow_succ, mul_comm (2 ^ a) 2, mul_assoc, hdbl, ih]

theorem add_mul_period (h : ℕ → α) {M : ℕ} (hper : ∀ n, h (n + M) = h n) (n k : ℕ) :
    h (n + M * k) = h n := by
  induction k with
  | zero => simp
  | succ k ih => rw [Nat.mul_succ, ← add_assoc, hper, ih]

theorem eq_of_mod_eq (h : ℕ → α) {M : ℕ} (hper : ∀ n, h (n + M) = h n) {a b : ℕ}
    (hab : a % M = b % M) : h a = h b := by
  have key : ∀ x, h x = h (x % M) := fun x => by
    rw [← add_mul_period h hper (x % M) (x / M), Nat.mod_add_div]
  rw [key a, key b, hab]

theorem eq_of_modEq (h : ℕ → α) {M : ℕ} (hper : ∀ n, h (n + M) = h n) {a b : ℕ}
    (hab : a ≡ b [MOD M]) : h a = h b :=
  eq_of_mod_eq h hper hab

/-- A multiple of a period is a period. -/
theorem period_of_dvd (h : ℕ → α) {p q : ℕ} (hpq : p ∣ q) (hp : ∀ n, h (n + p) = h n) :
    ∀ n, h (n + q) = h n := by
  obtain ⟨k, rfl⟩ := hpq
  exact fun n => add_mul_period h hp n k

/-- Two periods give their gcd as a period (Euclidean algorithm). -/
theorem period_gcd (h : ℕ → α) : ∀ p q : ℕ, (∀ n, h (n + p) = h n) → (∀ n, h (n + q) = h n) →
    ∀ n, h (n + Nat.gcd p q) = h n := by
  intro p q
  induction p, q using Nat.gcd.induction with
  | H0 q => intro _ hq; simpa using hq
  | H1 p q _ ih =>
    intro hp hq
    rw [Nat.gcd_rec]
    refine ih ?_ hp
    intro n
    calc h (n + q % p) = h (n + q % p + p * (q / p)) := (add_mul_period h hp _ _).symm
      _ = h (n + q) := by rw [add_assoc, Nat.mod_add_div]
      _ = h n := hq n

/-- An even period halves, by doubling invariance. -/
theorem period_half (h : ℕ → α) (hdbl : ∀ n, h (2 * n) = h n) {K : ℕ}
    (hper : ∀ n, h (n + 2 * K) = h n) : ∀ n, h (n + K) = h n := by
  intro n
  rw [← hdbl (n + K), mul_add, hper, hdbl]

/-! ### The odd rule on every residue -/

/-- For an odd period `M ≥ 3`, the rule `h (3x + d) = h x` holds at **every** `x`: use
the representative `x + M` (for even `x`) or `x + 2M` (for odd `x`). -/
theorem tri_all (h : ℕ → α) {d M : ℕ} (hM3 : 3 ≤ M) (hMo : Odd M)
    (hper : ∀ n, h (n + M) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + d) = h n) :
    ∀ x, h (3 * x + d) = h x := by
  intro x
  rcases Nat.even_or_odd x with hx | hx
  · have hodd : Odd (x + M) := hx.add_odd hMo
    have := htri (x + M) hodd (by omega)
    rw [show 3 * (x + M) + d = (3 * x + d) + M * 3 by ring, add_mul_period h hper] at this
    rw [this, hper]
  · have hodd : Odd (x + 2 * M) := hx.add_even ⟨M, by ring⟩
    have := htri (x + 2 * M) hodd (by omega)
    rw [show 3 * (x + 2 * M) + d = (3 * x + d) + M * 6 by ring, add_mul_period h hper,
      show x + 2 * M = x + M * 2 by ring, add_mul_period h hper] at this
    exact this

/-- The two six-fold identities `h (6x + d) = h x = h (6x + 2d)`. -/
theorem six_rule (h : ℕ → α) {d M : ℕ} (hM3 : 3 ≤ M) (hMo : Odd M)
    (hper : ∀ n, h (n + M) = h n) (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + d) = h n) (x : ℕ) :
    h (6 * x + d) = h x ∧ h (6 * x + 2 * d) = h x := by
  have t := tri_all h hM3 hMo hper htri
  constructor
  · rw [show 6 * x + d = 3 * (2 * x) + d by ring, t, hdbl]
  · rw [show 6 * x + 2 * d = 2 * (3 * x + d) by ring, hdbl, t]

/-- A period `3K` (odd) drops to `K`: `6(x+K) + d ≡ 6x + d (mod 3K)`. -/
theorem period_div_three (h : ℕ → α) {d K : ℕ} (hK : 0 < K) (hKo : Odd K)
    (hper : ∀ n, h (n + 3 * K) = h n) (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + d) = h n) : ∀ n, h (n + K) = h n := by
  have hM3 : 3 ≤ 3 * K := by omega
  have hMo : Odd (3 * K) := Nat.odd_mul.mpr ⟨⟨1, by norm_num⟩, hKo⟩
  intro n
  have s := six_rule h hM3 hMo hper hdbl htri
  calc h (n + K) = h (6 * (n + K) + d) := (s (n + K)).1.symm
    _ = h (6 * n + d + 3 * K * 2) := by rw [show 6 * (n + K) + d = 6 * n + d + 3 * K * 2 by ring]
    _ = h (6 * n + d) := add_mul_period h hper _ _
    _ = h n := (s n).1

/-- For a period `M ≥ 3` coprime to `6`, translation by `d` preserves colours. -/
theorem period_d_of_coprime (h : ℕ → α) {d M : ℕ} (hM3 : 3 ≤ M) (hMo : Odd M)
    (hcop : Nat.Coprime 6 M) (hper : ∀ n, h (n + M) = h n) (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + d) = h n) : ∀ n, h (n + d) = h n := by
  obtain ⟨u, -, hu⟩ := Nat.exists_mul_mod_eq_one_of_coprime hcop (by omega : 1 < M)
  obtain ⟨M', rfl⟩ : ∃ M', M = M' + 1 := ⟨M - 1, by omega⟩
  intro n
  set x := u * (n + d * M') with hx
  have h6u : 6 * u ≡ 1 [MOD M' + 1] := by
    unfold Nat.ModEq
    rw [hu, Nat.mod_eq_of_lt (by omega : 1 < M' + 1)]
  have key : 6 * x + d ≡ n [MOD M' + 1] := by
    calc 6 * x + d = (6 * u) * (n + d * M') + d := by rw [hx]; ring
      _ ≡ 1 * (n + d * M') + d [MOD M' + 1] := (h6u.mul_right _).add_right _
      _ = n + (M' + 1) * d := by ring
      _ ≡ n [MOD M' + 1] := by
        unfold Nat.ModEq
        rw [Nat.add_mul_mod_self_left]
  have key2 : 6 * x + 2 * d ≡ n + d [MOD M' + 1] := by
    have := key.add_right d
    rwa [show 6 * x + d + d = 6 * x + 2 * d by ring] at this
  have s := six_rule h hM3 hMo hper hdbl htri x
  calc h (n + d) = h (6 * x + 2 * d) := eq_of_modEq h hper key2.symm
    _ = h x := s.2
    _ = h (6 * x + d) := s.1.symm
    _ = h n := eq_of_modEq h hper key

/-! ### The classification -/

/-- **Period reduction.** An `M`-periodic `3x+d`-invariant colouring is
`gcd(M, d)`-periodic. -/
theorem period_gcd_of_invariant (h : ℕ → α) {d : ℕ} (hd : Odd d)
    (hdbl : ∀ n, h (2 * n) = h n) (htri : ∀ n, Odd n → 1 < n → h (3 * n + d) = h n) :
    ∀ M, 0 < M → (∀ n, h (n + M) = h n) → ∀ n, h (n + Nat.gcd M d) = h n := by
  have hcop2 : Nat.Coprime 2 d :=
    (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).mpr (by obtain ⟨k, hk⟩ := hd; omega)
  intro M
  induction M using Nat.strong_induction_on with
  | _ M ih =>
    intro hM hper
    rcases Nat.even_or_odd M with ⟨K, hK⟩ | hMo
    · have hM2 : M = 2 * K := by omega
      subst hM2
      have := ih K (by omega) (by omega) (period_half h hdbl hper)
      rwa [Nat.Coprime.gcd_mul_left_cancel K hcop2]
    · by_cases h3 : 3 ∣ M
      · obtain ⟨K, rfl⟩ := h3
        have hKo : Odd K := (Nat.odd_mul.mp hMo).2
        have := ih K (by omega) (by omega) (period_div_three h (by omega) hKo hper hdbl htri)
        exact period_of_dvd h (Nat.gcd_dvd_gcd_of_dvd_left d (dvd_mul_left K 3)) this
      · rcases Nat.lt_or_ge M 3 with hlt | hge
        · have hM1 : M = 1 := by obtain ⟨k, hk⟩ := hMo; omega
          subst hM1
          simpa using hper
        · have h2 : ¬ 2 ∣ M := by obtain ⟨k, hk⟩ := hMo; omega
          have hcop : Nat.Coprime 6 M := by
            show Nat.Coprime (2 * 3) M
            exact Nat.coprime_mul_iff_left.mpr
              ⟨(Nat.Prime.coprime_iff_not_dvd Nat.prime_two).mpr h2,
               (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mpr h3⟩
          exact period_gcd h M d hper (period_d_of_coprime h hge hMo hcop hper hdbl htri)

/-- From any period, the odd rule holds at every `x`. -/
theorem tri_all_of_period (h : ℕ → α) {d : ℕ} (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + d) = h n) :
    ∀ M, 0 < M → (∀ n, h (n + M) = h n) → ∀ x, h (3 * x + d) = h x := by
  intro M
  induction M using Nat.strong_induction_on with
  | _ M ih =>
    intro hM hper x
    rcases Nat.even_or_odd M with ⟨K, hK⟩ | hMo
    · have hM2 : M = 2 * K := by omega
      subst hM2
      exact ih K (by omega) (by omega) (period_half h hdbl hper) x
    · rcases Nat.lt_or_ge M 3 with hlt | hge
      · have hM1 : M = 1 := by obtain ⟨k, hk⟩ := hMo; omega
        subst hM1
        exact eq_of_mod_eq h hper (by simp [Nat.mod_one])
      · exact tri_all h hge hMo hper htri x

/-- Multiplication by `3` preserves colours. -/
theorem three_mul_of_invariant (h : ℕ → α) {d : ℕ} (hd : Odd d)
    (hdbl : ∀ n, h (2 * n) = h n) (htri : ∀ n, Odd n → 1 < n → h (3 * n + d) = h n)
    {M : ℕ} (hM : 0 < M) (hper : ∀ n, h (n + M) = h n) : ∀ n, h (3 * n) = h n := by
  have hg := period_gcd_of_invariant h hd hdbl htri M hM hper
  have hdper : ∀ n, h (n + d) = h n := period_of_dvd h (Nat.gcd_dvd_right M d) hg
  have hall := tri_all_of_period h hdbl htri M hM hper
  intro n
  rw [← hdper (3 * n), hall]

/-- **V002 Appendix, general `d` (written proof there; formal here).** An `M`-periodic
`3x+d`-invariant colouring is `gcd(M,d)`-periodic and invariant under multiplication
by `2` and by `3`: it factors through `Z/gcd(M,d)Z` and is constant on the classes
generated by `×2` and `×3` there. -/
theorem invariant_classification (h : ℕ → α) {d M : ℕ} (hd : Odd d) (hM : 0 < M)
    (hper : ∀ n, h (n + M) = h n) (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + d) = h n) :
    (∀ n, h (n + Nat.gcd M d) = h n) ∧ (∀ n, h (2 * n) = h n) ∧ (∀ n, h (3 * n) = h n) :=
  ⟨period_gcd_of_invariant h hd hdbl htri M hM hper, hdbl,
    three_mul_of_invariant h hd hdbl htri hM hper⟩

/-- **Converse.** For `g ∣ d`, a `g`-periodic `F` invariant under `×2` and `×3` is a
`3x+d`-invariant colouring (and `M`-periodic for every multiple `M` of `g`). -/
theorem invariant_of_class_function (F : ℕ → α) {d g : ℕ} (hg : g ∣ d)
    (hF : ∀ n, F (n + g) = F n) (h2 : ∀ n, F (2 * n) = F n) (h3 : ∀ n, F (3 * n) = F n) :
    (∀ n, F (2 * n) = F n) ∧ (∀ n, Odd n → 1 < n → F (3 * n + d) = F n) :=
  ⟨h2, fun n _ _ => by rw [period_of_dvd F hg hF (3 * n), h3]⟩

/-! ### Refinement: the six-free part of the period -/

theorem period_strip_two (h : ℕ → α) (hdbl : ∀ n, h (2 * n) = h n) :
    ∀ a K, (∀ n, h (n + 2 ^ a * K) = h n) → ∀ n, h (n + K) = h n := by
  intro a
  induction a with
  | zero => intro K hK; simpa using hK
  | succ a ih =>
    intro K hK
    apply ih
    apply period_half h hdbl
    intro n
    rw [show 2 * (2 ^ a * K) = 2 ^ (a + 1) * K by ring]
    exact hK n

theorem period_strip_three (h : ℕ → α) {d : ℕ} (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + d) = h n) :
    ∀ b K, Odd K → (∀ n, h (n + 3 ^ b * K) = h n) → ∀ n, h (n + K) = h n := by
  intro b
  induction b with
  | zero => intro K _ hK; simpa using hK
  | succ b ih =>
    intro K hKo hK
    apply ih K hKo
    apply period_div_three h (d := d) (Nat.mul_pos (pow_pos (by norm_num) b) hKo.pos)
      (Nat.odd_mul.mpr ⟨Odd.pow ⟨1, by norm_num⟩, hKo⟩) _ hdbl htri
    intro n
    rw [show 3 * (3 ^ b * K) = 3 ^ (b + 1) * K by ring]
    exact hK n

/-- **Refinement.** A period `2^a 3^b M'` with `M'` odd gives the period `gcd(M', d)`;
for `3 ∣ d` this is stronger than `gcd(M, d)`. -/
theorem period_gcd_six_free (h : ℕ → α) {d : ℕ} (hd : Odd d)
    (hdbl : ∀ n, h (2 * n) = h n) (htri : ∀ n, Odd n → 1 < n → h (3 * n + d) = h n)
    {a b M' : ℕ} (hM' : Odd M') (hper : ∀ n, h (n + 2 ^ a * 3 ^ b * M') = h n) :
    ∀ n, h (n + Nat.gcd M' d) = h n := by
  have h1 : ∀ n, h (n + 3 ^ b * M') = h n :=
    period_strip_two h hdbl a (3 ^ b * M') (fun n => by rw [← mul_assoc]; exact hper n)
  have h2 : ∀ n, h (n + M') = h n := period_strip_three h hdbl htri b M' hM' h1
  exact period_gcd_of_invariant h hd hdbl htri M' hM'.pos h2

/-! ### Eventual periods -/

theorem le_two_pow : ∀ N : ℕ, N ≤ 2 ^ N := by
  intro N
  induction N with
  | zero => simp
  | succ N ih =>
    have : 0 < 2 ^ N := by positivity
    rw [pow_succ]
    omega

/-- An eventual period of an invariant colouring gives the same conclusions on the
positive integers. -/
theorem eventually_periodic_invariant (h : ℕ → α) {d M N : ℕ} (hd : Odd d) (hM : 0 < M)
    (hev : ∀ n, N ≤ n → h (n + M) = h n) (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + d) = h n) :
    (∀ n, 0 < n → h (n + Nat.gcd M d) = h n) ∧ (∀ n, 0 < n → h (3 * n) = h n) := by
  have hev' : ∀ j n, N ≤ n → h (n + M * j) = h n := by
    intro j
    induction j with
    | zero => intro n _; simp
    | succ j ih =>
      intro n hn
      rw [Nat.mul_succ, ← add_assoc, hev _ (by omega), ih n hn]
  have hglob : ∀ n, 0 < n → h (n + M) = h n := by
    intro n hn
    have hbig : N ≤ 2 ^ N * n := le_trans (le_two_pow N) (Nat.le_mul_of_pos_right _ hn)
    calc h (n + M) = h (2 ^ N * (n + M)) := (pow_two_mul h hdbl N _).symm
      _ = h (2 ^ N * n + M * 2 ^ N) := by rw [show 2 ^ N * (n + M) = 2 ^ N * n + M * 2 ^ N by ring]
      _ = h (2 ^ N * n) := hev' _ _ hbig
      _ = h n := pow_two_mul h hdbl N n
  -- modify the colouring at `0` so that the period holds everywhere
  set h' : ℕ → α := fun n => if n = 0 then h M else h n with hh'
  have h'per : ∀ n, h' (n + M) = h' n := by
    intro n
    by_cases hn : n = 0
    · subst hn; simp [hh']
    · simp [hh', hn, hglob n (Nat.pos_of_ne_zero hn)]
  have h'dbl : ∀ n, h' (2 * n) = h' n := by
    intro n
    by_cases hn : n = 0
    · subst hn; simp [hh']
    · simp [hh', hn, hdbl]
  have h'tri : ∀ n, Odd n → 1 < n → h' (3 * n + d) = h' n := by
    intro n hn h1
    have hn0 : n ≠ 0 := by omega
    simp [hh', hn0, htri n hn h1]
  obtain ⟨p, -, t⟩ := invariant_classification h' hd hM h'per h'dbl h'tri
  constructor
  · intro n hn
    have := p n
    simpa [hh', hn.ne', (by omega : n + Nat.gcd M d ≠ 0)] using this
  · intro n hn
    have := t n
    simpa [hh', hn.ne', (by omega : 3 * n ≠ 0)] using this

/-! ### Controls -/

/-- The indicator of `d ∣ n`. -/
def indicator (d n : ℕ) : Bool := decide (d ∣ n)

/-- For odd `d` with `3 ∤ d`, the indicator of `d ∣ n` is a `d`-periodic invariant
colouring of `3x+d`, nonconstant when `d > 1`. -/
theorem control_indicator {d : ℕ} (hd : Odd d) (h3 : ¬ 3 ∣ d) :
    (∀ n, indicator d (n + d) = indicator d n) ∧ (∀ n, indicator d (2 * n) = indicator d n) ∧
      (∀ n, Odd n → 1 < n → indicator d (3 * n + d) = indicator d n) ∧
      (1 < d → indicator d 1 ≠ indicator d d) := by
  have hcop2 : Nat.Coprime d 2 :=
    ((Nat.Prime.coprime_iff_not_dvd Nat.prime_two).mpr (by obtain ⟨k, hk⟩ := hd; omega)).symm
  have hcop3 : Nat.Coprime d 3 := ((Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mpr h3).symm
  refine ⟨fun n => ?_, fun n => ?_, fun n _ _ => ?_, fun hd1 => ?_⟩
  · exact decide_eq_decide.mpr Nat.dvd_add_self_right
  · exact decide_eq_decide.mpr hcop2.dvd_mul_left
  · exact decide_eq_decide.mpr (Nat.dvd_add_self_right.trans hcop3.dvd_mul_left)
  · simp [indicator, Nat.dvd_one, hd1.ne']

theorem control_five :
    (∀ n, indicator 5 (n + 5) = indicator 5 n) ∧ (∀ n, indicator 5 (2 * n) = indicator 5 n) ∧
      (∀ n, Odd n → 1 < n → indicator 5 (3 * n + 5) = indicator 5 n) ∧
      (1 < 5 → indicator 5 1 ≠ indicator 5 5) :=
  control_indicator ⟨2, by norm_num⟩ (by decide)

theorem control_sixty_one :
    (∀ n, indicator 61 (n + 61) = indicator 61 n) ∧
      (∀ n, indicator 61 (2 * n) = indicator 61 n) ∧
      (∀ n, Odd n → 1 < n → indicator 61 (3 * n + 61) = indicator 61 n) ∧
      (1 < 61 → indicator 61 1 ≠ indicator 61 61) :=
  control_indicator ⟨30, by norm_num⟩ (by decide)

/-! ### The statement on `Z/gZ` -/

/-- The classification in V002's form: `h` factors through `Z/gZ`, `g = gcd(M,d)`, via a
function invariant under multiplication by `2` and by `3`. -/
theorem factors_through_zmod (h : ℕ → α) {d M : ℕ} (hd : Odd d) (hM : 0 < M)
    (hper : ∀ n, h (n + M) = h n) (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + d) = h n) :
    ∃ F : ZMod (Nat.gcd M d) → α, (∀ n : ℕ, h n = F n) ∧
      (∀ z, F (2 * z) = F z) ∧ (∀ z, F (3 * z) = F z) := by
  obtain ⟨hg, h2, h3⟩ := invariant_classification h hd hM hper hdbl htri
  have hg0 : 0 < Nat.gcd M d := Nat.gcd_pos_of_pos_left d hM
  have : NeZero (Nat.gcd M d) := ⟨hg0.ne'⟩
  have mul_val : ∀ (c : ℕ) (z : ZMod (Nat.gcd M d)),
      h (((c : ZMod (Nat.gcd M d)) * z).val) = h (c * z.val) := by
    intro c z
    rw [ZMod.val_mul, ZMod.val_natCast]
    apply eq_of_mod_eq h hg
    rw [Nat.mod_mod, Nat.mul_mod, Nat.mod_mod, ← Nat.mul_mod]
  refine ⟨fun z => h z.val, fun n => ?_, fun z => ?_, fun z => ?_⟩
  · show h n = h ((n : ZMod (Nat.gcd M d)).val)
    rw [ZMod.val_natCast]
    exact eq_of_mod_eq h hg (Nat.mod_mod _ _).symm
  · show h ((2 * z).val) = h z.val
    rw [← Nat.cast_ofNat (R := ZMod (Nat.gcd M d)) (n := 2), mul_val, h2]
  · show h ((3 * z).val) = h z.val
    rw [← Nat.cast_ofNat (R := ZMod (Nat.gcd M d)) (n := 3), mul_val, h3]

end GenPer
end LeanLane
