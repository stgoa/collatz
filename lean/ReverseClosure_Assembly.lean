/-!
# Odd-eventually-periodic rigidity of Collatz-invariant colourings (V004-i)

Lane: `claude/lean-lane`. Prose source: main's
`experiments/viewpoints/V004/GLOBAL_RIGIDITY.md`, §2 (identities) and §5
(the elementary finish after Cobham): if a colouring `h` satisfies

* `h (2 * n) = h n` for all `n`,
* `h (3 * n + 1) = h n` for all odd `n > 1`,

and its odd restriction `b n = h (2 * n + 1)` is eventually periodic, then
`h` is constant on the positive integers. This is the whole content of V004
except the two external inputs (Cobham's theorem and the finite-kernel
characterisation of automaticity), which produce the eventual periodicity of
`b` from binary automaticity. It strictly strengthens `PeriodicRigidity.lean`.

The proof is integer-level and uses three identities of `b`, all derived from
the two rules: `b (4n+2) = b n`, `b (3n+2) = b (2n+1)`, `b (4n) = b (3n)`.

1. `period_of_eventually`: an eventual period `M = 2^e L` of `b` is a global
   period `L` (odd), because `G n = 4n+2` preserves `b` and
   `G^[k] (n+L) = G^[k] n + 4^k L`.
2. `period_div_three`: a period `3K` of `b` yields the period `K` (strong
   induction on `n`, splitting `n` modulo 4).
3. `succ_eq`: for a period `L > 1` coprime to 6, with `c = (L+1)/2`,
   `b (3y+2) = b y = b (3 (y+c))` for all `y`; choosing `y` with
   `3 (y+c) ≡ n (mod L)` gives `b (n+c) = b n`, hence `b (n+1) = b n`.
4. `const_of_period` strips factors of 3 and concludes;
   `odd_eventually_periodic_const` transfers constancy of `b` to all positive
   integers by doubling.
-/

namespace LeanLane
namespace OddEP

variable {α : Type*} (h : ℕ → α)

/-- The odd restriction of a colouring. -/
def b (n : ℕ) : α := h (2 * n + 1)

/-- The map `n ↦ 4n+2`. -/
def G (n : ℕ) : ℕ := 4 * n + 2

/-! ### Identities derived from the two colouring rules -/

theorem pow_two_mul (hdbl : ∀ n, h (2 * n) = h n) (a n : ℕ) : h (2 ^ a * n) = h n := by
  induction a with
  | zero => simp
  | succ a ih => rw [pow_succ, mul_comm (2 ^ a) 2, mul_assoc, hdbl, ih]

/-- The odd rule, including `n = 1`. -/
theorem tri' (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + 1) = h n) (n : ℕ) (hn : Odd n) :
    h (3 * n + 1) = h n := by
  rcases Nat.lt_or_ge 1 n with h1 | h1
  · exact htri n hn h1
  · have hn1 : n = 1 := by
      obtain ⟨k, hk⟩ := hn
      omega
    subst hn1
    calc h (3 * 1 + 1) = h (2 * 2) := by norm_num
      _ = h 2 := hdbl 2
      _ = h (2 * 1) := by norm_num
      _ = h 1 := hdbl 1

/-- V004 (2), first identity: `h (3m+1) = h (4m+1)`. -/
theorem id2 (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + 1) = h n) (m : ℕ) :
    h (3 * m + 1) = h (4 * m + 1) := by
  have := tri' h hdbl htri (4 * m + 1) ⟨2 * m, by ring⟩
  rw [show 3 * (4 * m + 1) + 1 = 2 * (2 * (3 * m + 1)) by ring, hdbl, hdbl] at this
  exact this

/-- V004 (4): `h (4x+1) = h x` for odd `x`. -/
theorem id4 (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + 1) = h n) (x : ℕ) (hx : Odd x) :
    h (4 * x + 1) = h x := by
  rw [← id2 h hdbl htri x]
  exact tri' h hdbl htri x hx

/-- `b (4n+2) = b n`. -/
theorem B1 (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + 1) = h n) (n : ℕ) :
    b h (4 * n + 2) = b h n := by
  unfold b
  rw [show 2 * (4 * n + 2) + 1 = 4 * (2 * n + 1) + 1 by ring]
  exact id4 h hdbl htri _ ⟨n, rfl⟩

/-- `b (3n+2) = b (2n+1)`. -/
theorem B2 (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + 1) = h n) (n : ℕ) :
    b h (3 * n + 2) = b h (2 * n + 1) := by
  unfold b
  have := tri' h hdbl htri (4 * n + 3) ⟨2 * n + 1, by ring⟩
  rw [show 3 * (4 * n + 3) + 1 = 2 * (2 * (3 * n + 2) + 1) by ring, hdbl] at this
  rw [show 2 * (2 * n + 1) + 1 = 4 * n + 3 by ring]
  exact this

/-- `b (4n) = b (3n)`. -/
theorem B4 (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + 1) = h n) (n : ℕ) :
    b h (4 * n) = b h (3 * n) := by
  unfold b
  have := tri' h hdbl htri (2 * (4 * n) + 1) ⟨4 * n, rfl⟩
  rw [show 3 * (2 * (4 * n) + 1) + 1 = 2 * (2 * (2 * (3 * n) + 1)) by ring, hdbl, hdbl] at this
  exact this.symm

/-! ### Periods of `b` -/

theorem add_mul_period {P : ℕ} (hper : ∀ n, b h (n + P) = b h n) (n k : ℕ) :
    b h (n + P * k) = b h n := by
  induction k with
  | zero => simp
  | succ k ih => rw [Nat.mul_succ, ← add_assoc, hper, ih]

theorem eq_of_mod_eq {P : ℕ} (hper : ∀ n, b h (n + P) = b h n) {x y : ℕ}
    (hxy : x % P = y % P) : b h x = b h y := by
  have key : ∀ x, b h x = b h (x % P) := fun x => by
    rw [← add_mul_period h hper (x % P) (x / P), Nat.mod_add_div]
  rw [key x, key y, hxy]

theorem G_iter_add (k : ℕ) : ∀ x y, G^[k] (x + y) = G^[k] x + 4 ^ k * y := by
  induction k with
  | zero => intro x y; simp
  | succ k ih =>
    intro x y
    rw [Function.iterate_succ_apply, Function.iterate_succ_apply,
      show G (x + y) = G x + 4 * y by unfold G; ring, ih, pow_succ]
    ring

theorem le_G_iter (k n : ℕ) : 2 * k ≤ G^[k] n := by
  induction k generalizing n with
  | zero => simp
  | succ k ih =>
    rw [Function.iterate_succ_apply']
    have := ih n
    show 2 * (k + 1) ≤ 4 * G^[k] n + 2
    omega

theorem b_G_iter (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + 1) = h n) (k n : ℕ) :
    b h (G^[k] n) = b h n := by
  induction k generalizing n with
  | zero => simp
  | succ k ih =>
    rw [Function.iterate_succ_apply, ih]
    exact B1 h hdbl htri n

/-- An eventual period of `b` yields a global odd period. -/
theorem period_of_eventually (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + 1) = h n) {N M : ℕ} (hM : 0 < M)
    (hev : ∀ n, N ≤ n → b h (n + M) = b h n) :
    ∃ L, Odd L ∧ ∀ n, b h (n + L) = b h n := by
  obtain ⟨e, L, hLnot, hMeq⟩ := Nat.exists_eq_pow_mul_and_not_dvd hM.ne' 2 (by norm_num)
  have hLodd : Odd L := Nat.not_even_iff_odd.mp (fun he => hLnot (even_iff_two_dvd.mp he))
  refine ⟨L, hLodd, fun n => ?_⟩
  have hev_mul : ∀ x, N ≤ x → ∀ j, b h (x + M * j) = b h x := by
    intro x hx j
    induction j with
    | zero => simp
    | succ j ih =>
      rw [Nat.mul_succ, ← add_assoc, hev _ (le_trans hx (Nat.le_add_right _ _)), ih]
  set k := N + e with hk
  have hbig : N ≤ G^[k] n := by
    have := le_G_iter k n
    omega
  have hdvd : 2 ^ e ∣ 4 ^ k := by
    rw [show (4 : ℕ) = 2 ^ 2 by norm_num, ← pow_mul]
    exact pow_dvd_pow 2 (by omega)
  obtain ⟨j, hj⟩ := hdvd
  calc b h (n + L) = b h (G^[k] (n + L)) := (b_G_iter h hdbl htri k _).symm
    _ = b h (G^[k] n + 4 ^ k * L) := by rw [G_iter_add]
    _ = b h (G^[k] n + M * j) := by
        rw [hj, hMeq]
        congr 1
        ring
    _ = b h (G^[k] n) := hev_mul _ hbig _
    _ = b h n := b_G_iter h hdbl htri k n

/-- A period `3K` of `b` yields the period `K`. -/
theorem period_div_three (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + 1) = h n) {K : ℕ}
    (hper : ∀ n, b h (n + 3 * K) = b h n) :
    ∀ n, b h (n + K) = b h n := by
  have two : ∀ m, b h (m + 2 * K) = b h m := by
    intro m
    induction m using Nat.strong_induction_on with
    | _ m ih =>
      rcases Nat.even_or_odd m with ⟨t, ht⟩ | ⟨t, ht⟩
      · rcases Nat.even_or_odd t with ⟨n, hn⟩ | ⟨n, hn⟩
        · have hm : m = 4 * n := by omega
          subst hm
          calc b h (4 * n + 2 * K)
              = b h (4 * n + 2 * K + 3 * K * 2) := (add_mul_period h hper _ _).symm
            _ = b h (4 * (n + 2 * K)) := by congr 1; ring
            _ = b h (3 * (n + 2 * K)) := B4 h hdbl htri _
            _ = b h (3 * n + 3 * K * 2) := by congr 1; ring
            _ = b h (3 * n) := add_mul_period h hper _ _
            _ = b h (4 * n) := (B4 h hdbl htri n).symm
        · have hm : m = 4 * n + 2 := by omega
          have hn_lt : n < m := by omega
          have ih_n := ih n hn_lt
          subst hm
          calc b h (4 * n + 2 + 2 * K)
              = b h (4 * n + 2 + 2 * K + 3 * K * 2) := (add_mul_period h hper _ _).symm
            _ = b h (4 * (n + 2 * K) + 2) := by congr 1; ring
            _ = b h (n + 2 * K) := B1 h hdbl htri _
            _ = b h n := ih_n
            _ = b h (4 * n + 2) := (B1 h hdbl htri n).symm
      · subst ht
        calc b h (2 * t + 1 + 2 * K) = b h (2 * (t + K) + 1) := by congr 1; ring
          _ = b h (3 * (t + K) + 2) := (B2 h hdbl htri _).symm
          _ = b h (3 * t + 2 + 3 * K) := by congr 1; ring
          _ = b h (3 * t + 2) := hper _
          _ = b h (2 * t + 1) := B2 h hdbl htri t
  intro n
  calc b h (n + K) = b h (n + K + 2 * K) := (two _).symm
    _ = b h (n + 3 * K) := by congr 1; ring
    _ = b h n := hper n

/-- For a period `L > 1` coprime to 6, consecutive values of `b` agree. -/
theorem succ_eq (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + 1) = h n) {L : ℕ} (hL : 1 < L)
    (hLodd : Odd L) (h3 : ¬ 3 ∣ L) (hper : ∀ n, b h (n + L) = b h n) :
    ∀ n, b h (n + 1) = b h n := by
  obtain ⟨c, hc⟩ : ∃ c, 2 * c = L + 1 := by
    obtain ⟨t, ht⟩ := hLodd
    exact ⟨t + 1, by omega⟩
  have h2 : Nat.Coprime 2 L := (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).2 (by
    intro hd
    exact (Nat.not_even_iff_odd.mpr hLodd) (even_iff_two_dvd.mpr hd))
  have hcop4 : Nat.Coprime 4 L := by
    have := Nat.Coprime.mul_left h2 h2
    norm_num at this
    exact this
  have hcop3 : Nat.Coprime 3 L := (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).2 h3
  obtain ⟨z4, -, hz4⟩ := Nat.exists_mul_mod_eq_one_of_coprime hcop4 hL
  obtain ⟨z3, -, hz3⟩ := Nat.exists_mul_mod_eq_one_of_coprime hcop3 hL
  have h4 : 4 * z4 ≡ 1 [MOD L] := by
    unfold Nat.ModEq
    rw [hz4, Nat.mod_eq_of_lt hL]
  have h3' : 3 * z3 ≡ 1 [MOD L] := by
    unfold Nat.ModEq
    rw [hz3, Nat.mod_eq_of_lt hL]
  -- (a) `b (3y+2) = b y`
  have ha : ∀ y, b h (3 * y + 2) = b h y := by
    intro y
    set x := z4 * y with hx
    have hxy : 4 * x ≡ y [MOD L] := by
      have := h4.mul_right y
      rwa [one_mul, show 4 * z4 * y = 4 * x by rw [hx]; ring] at this
    have h12 : 3 * y + 2 ≡ 4 * (3 * x) + 2 [MOD L] := by
      have := (hxy.mul_left 3).add_right 2
      rw [show 3 * (4 * x) + 2 = 4 * (3 * x) + 2 by ring] at this
      exact this.symm
    calc b h (3 * y + 2) = b h (4 * (3 * x) + 2) := eq_of_mod_eq h hper h12
      _ = b h (3 * x) := B1 h hdbl htri _
      _ = b h (4 * x) := (B4 h hdbl htri x).symm
      _ = b h y := eq_of_mod_eq h hper hxy
  -- (b) `b (3 (y + c)) = b y`
  have hb : ∀ y, b h (3 * (y + c)) = b h y := by
    intro y
    calc b h (3 * (y + c)) = b h (4 * (y + c)) := (B4 h hdbl htri _).symm
      _ = b h (4 * y + 2 + L * 2) := by congr 1; omega
      _ = b h (4 * y + 2) := add_mul_period h hper _ _
      _ = b h y := B1 h hdbl htri y
  -- (c) `b (n + c) = b n`
  have hshift : ∀ n, b h (n + c) = b h n := by
    intro n
    have hcle : 3 * c ≤ 3 * L := by omega
    set y := z3 * (n + 3 * L - 3 * c) with hy
    have h3y : 3 * y ≡ n + 3 * L - 3 * c [MOD L] := by
      have := h3'.mul_right (n + 3 * L - 3 * c)
      rwa [one_mul, show 3 * z3 * (n + 3 * L - 3 * c) = 3 * y by rw [hy]; ring] at this
    have e1 : 3 * y + 3 * c ≡ n [MOD L] := by
      have := h3y.add_right (3 * c)
      rw [show n + 3 * L - 3 * c + 3 * c = n + L * 3 by omega] at this
      exact this.trans (Nat.add_mul_mod_self_left n L 3)
    have e2 : 3 * y + 2 ≡ n + c [MOD L] := by
      have := h3y.add_right 2
      rw [show n + 3 * L - 3 * c + 2 = n + c + L * 1 by omega] at this
      exact this.trans (Nat.add_mul_mod_self_left (n + c) L 1)
    symm
    calc b h n = b h (3 * y + 3 * c) := (eq_of_mod_eq h hper e1).symm
      _ = b h (3 * (y + c)) := by congr 1; ring
      _ = b h y := hb y
      _ = b h (3 * y + 2) := (ha y).symm
      _ = b h (n + c) := eq_of_mod_eq h hper e2
  intro n
  calc b h (n + 1) = b h (n + 1 + L) := (hper _).symm
    _ = b h (n + c + c) := by congr 1; omega
    _ = b h (n + c) := hshift _
    _ = b h n := hshift n

/-- A periodic `b` (odd period) is constant. -/
theorem const_of_period (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + 1) = h n) :
    ∀ L, Odd L → (∀ n, b h (n + L) = b h n) → ∀ n, b h n = b h 0 := by
  intro L
  induction L using Nat.strong_induction_on with
  | _ L ih =>
    intro hLodd hper
    by_cases h3 : 3 ∣ L
    · obtain ⟨K, hK⟩ := h3
      have hKodd : Odd K := by
        rw [hK] at hLodd
        exact (Nat.odd_mul.mp hLodd).2
      have hKlt : K < L := by
        have := hKodd.pos
        omega
      have hper3 : ∀ n, b h (n + 3 * K) = b h n := fun n => by
        rw [← hK]
        exact hper n
      exact ih K hKlt hKodd (period_div_three h hdbl htri hper3)
    · rcases Nat.lt_or_ge 1 L with hL | hL
      · have hs := succ_eq h hdbl htri hL hLodd h3 hper
        intro n
        induction n with
        | zero => rfl
        | succ k ihk => rw [hs k, ihk]
      · have hL1 : L = 1 := by
          have := hLodd.pos
          omega
        subst hL1
        intro n
        induction n with
        | zero => rfl
        | succ k ihk => rw [hper k, ihk]

/-- **Odd-eventually-periodic rigidity.** If `h (2n) = h n` for all `n`,
`h (3n+1) = h n` for all odd `n > 1`, and `n ↦ h (2n+1)` is eventually periodic
(period `M > 0` from index `N` on), then `h` is constant on the positive integers. -/
theorem odd_eventually_periodic_const (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + 1) = h n) {N M : ℕ} (hM : 0 < M)
    (hev : ∀ n, N ≤ n → h (2 * (n + M) + 1) = h (2 * n + 1)) :
    ∀ n, 0 < n → h n = h 1 := by
  have hev' : ∀ n, N ≤ n → b h (n + M) = b h n := hev
  obtain ⟨L, hLodd, hper⟩ := period_of_eventually h hdbl htri hM hev'
  have hconst := const_of_period h hdbl htri L hLodd hper
  intro n hn
  obtain ⟨a, m, hmnot, hmeq⟩ := Nat.exists_eq_pow_mul_and_not_dvd hn.ne' 2 (by norm_num)
  have hmodd : Odd m := Nat.not_even_iff_odd.mp (fun he => hmnot (even_iff_two_dvd.mp he))
  obtain ⟨t, ht⟩ := hmodd
  rw [hmeq, pow_two_mul h hdbl, ht]
  have := hconst t
  simp only [b] at this
  rw [this]

end OddEP
end LeanLane


/-!
# Ternary closure of the positive-offset binary kernel (V004-ii)

Lane: `claude/lean-lane`. Prose source: main's
`experiments/viewpoints/V004/GLOBAL_RIGIDITY.md`, §§2–3.

For a colouring `h : ℕ → α` with `h (2n) = h n` for all `n` and
`h (3n+1) = h n` for all odd `n > 1`, consider the sections
`n ↦ h (2^a n + r)` with `a ≥ 1` and `0 < r < 2^a` (V004's family `K₊`).
Taking a ternary section (`n ↦ 3n + j`, `j < 3`) of such a section gives
again a member of the family: `kernel_ternary_closure` produces `a' ≥ 1` and
`0 < r' < 2^a'` with `h (2^a (3n+j) + r) = h (2^a' n + r')` for every `n`.
Binary sections stay in the family trivially (`kernel_binary_closure`).

This is the elementary identity content of V004 §3. Combined with the
finiteness of the binary kernel of a binary-automatic `h` (so that `K₊` is
finite) and Cobham's theorem, it is what makes `n ↦ h (2n+1)` eventually
periodic; those two external inputs are not formalised here. Nothing in this
file concerns convergence of orbits.
-/

namespace LeanLane
namespace Kernel

variable {α : Type*} (h : ℕ → α)

theorem pow_two_mul (hdbl : ∀ n, h (2 * n) = h n) (a n : ℕ) : h (2 ^ a * n) = h n := by
  induction a with
  | zero => simp
  | succ a ih => rw [pow_succ, mul_comm (2 ^ a) 2, mul_assoc, hdbl, ih]

/-- The odd rule, including `n = 1`. -/
theorem tri' (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + 1) = h n) (n : ℕ) (hn : Odd n) :
    h (3 * n + 1) = h n := by
  rcases Nat.lt_or_ge 1 n with h1 | h1
  · exact htri n hn h1
  · have hn1 : n = 1 := by
      obtain ⟨k, hk⟩ := hn
      omega
    subst hn1
    calc h (3 * 1 + 1) = h (2 * 2) := by norm_num
      _ = h 2 := hdbl 2
      _ = h (2 * 1) := by norm_num
      _ = h 1 := hdbl 1

/-- V004 (2), first identity: `h (3m+1) = h (4m+1)`. -/
theorem id2 (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + 1) = h n) (m : ℕ) :
    h (3 * m + 1) = h (4 * m + 1) := by
  have := tri' h hdbl htri (4 * m + 1) ⟨2 * m, by ring⟩
  rw [show 3 * (4 * m + 1) + 1 = 2 * (2 * (3 * m + 1)) by ring, hdbl, hdbl] at this
  exact this

/-- V004 (3): `h (3u) = h (16u+1)` for odd `u`. -/
theorem id3 (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + 1) = h n) (u : ℕ) (hu : Odd u) :
    h (3 * u) = h (16 * u + 1) := by
  have h1 := tri' h hdbl htri (3 * u) (Nat.odd_mul.mpr ⟨⟨1, rfl⟩, hu⟩)
  have h2 := id2 h hdbl htri (3 * u)
  have h3 := id2 h hdbl htri (4 * u)
  rw [← h1, h2, show 4 * (3 * u) + 1 = 3 * (4 * u) + 1 by ring, h3]
  congr 1
  ring

/-- Binary sections of the positive-offset family stay in the family. -/
theorem kernel_binary_closure {a r : ℕ} (ha : 1 ≤ a) (hr0 : 0 < r) (hr : r < 2 ^ a)
    {i : ℕ} (hi : i < 2) :
    ∃ a' r', 1 ≤ a' ∧ 0 < r' ∧ r' < 2 ^ a' ∧
      ∀ n, h (2 ^ a * (2 * n + i) + r) = h (2 ^ a' * n + r') := by
  refine ⟨a + 1, 2 ^ a * i + r, by omega, by omega, ?_, fun n => ?_⟩
  · have : 2 ^ a * i ≤ 2 ^ a * 1 := Nat.mul_le_mul_left _ (by omega)
    rw [pow_succ]
    omega
  · congr 1
    rw [pow_succ]
    ring

/-- **Ternary closure of the positive-offset family** (V004 §3). -/
theorem kernel_ternary_closure (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + 1) = h n)
    {a r : ℕ} (ha : 1 ≤ a) (hr0 : 0 < r) (hr : r < 2 ^ a) {j : ℕ} (hj : j < 3) :
    ∃ a' r', 1 ≤ a' ∧ 0 < r' ∧ r' < 2 ^ a' ∧
      ∀ n, h (2 ^ a * (3 * n + j) + r) = h (2 ^ a' * n + r') := by
  set c := 2 ^ a * j + r with hc
  have hc0 : 0 < c := Nat.add_pos_right _ hr0
  have hclt : c < 3 * 2 ^ a := by
    have : 2 ^ a * j ≤ 2 ^ a * 2 := Nat.mul_le_mul_left _ (by omega)
    omega
  have key : ∀ n, 2 ^ a * (3 * n + j) + r = 3 * (2 ^ a * n) + c := by
    intro n
    rw [hc]
    ring
  have hp1 : 2 ^ (a + 1) = 2 * 2 ^ a := by rw [pow_succ]; ring
  have hp2 : 2 ^ (a + 2) = 4 * 2 ^ a := by rw [pow_succ, pow_succ]; ring
  rcases (show c % 3 = 0 ∨ c % 3 = 1 ∨ c % 3 = 2 by omega) with h0 | h1 | h2
  · -- Case B: `3 ∣ c`
    obtain ⟨t, ht⟩ : ∃ t, c = 3 * t := ⟨c / 3, by omega⟩
    have ht0 : t ≠ 0 := by omega
    have htlt : t < 2 ^ a := by omega
    obtain ⟨ℓ, u, hu2, htu⟩ := Nat.exists_eq_pow_mul_and_not_dvd ht0 2 (by norm_num)
    have huodd : Odd u := Nat.not_even_iff_odd.mp (fun he => hu2 (even_iff_two_dvd.mp he))
    have hu0 : 0 < u := huodd.pos
    have hla : ℓ < a := by
      rcases Nat.lt_or_ge ℓ a with hlt | hge
      · exact hlt
      · exfalso
        have h1' : 2 ^ a ≤ 2 ^ ℓ := Nat.pow_le_pow_right (by norm_num) hge
        have h2' : 2 ^ ℓ ≤ 2 ^ ℓ * u := Nat.le_mul_of_pos_right _ hu0
        omega
    obtain ⟨s, hs⟩ := Nat.exists_eq_add_of_lt hla
    -- `a = ℓ + s + 1`; write `s1 = s + 1 ≥ 1`
    have hpa : 2 ^ a = 2 ^ ℓ * 2 ^ (s + 1) := by rw [hs]; ring
    have hu_lt : u < 2 ^ (s + 1) := by
      have hpos : 0 < 2 ^ ℓ := by positivity
      have : 2 ^ ℓ * u < 2 ^ ℓ * 2 ^ (s + 1) := by rw [← hpa, ← htu]; exact htlt
      exact Nat.lt_of_mul_lt_mul_left this
    have hp4 : 2 ^ (s + 1 + 4) = 16 * 2 ^ (s + 1) := by rw [pow_add]; ring
    refine ⟨s + 1 + 4, 16 * u + 1, by omega, by omega, by omega, fun n => ?_⟩
    have hodd' : Odd (2 ^ (s + 1) * n + u) := by
      have : Even (2 ^ (s + 1) * n) := ⟨2 ^ s * n, by rw [pow_succ]; ring⟩
      exact this.add_odd huodd
    calc h (2 ^ a * (3 * n + j) + r) = h (3 * (2 ^ a * n) + c) := by rw [key]
      _ = h (2 ^ ℓ * (3 * (2 ^ (s + 1) * n + u))) := by
          congr 1
          rw [ht, htu, hpa]
          ring
      _ = h (3 * (2 ^ (s + 1) * n + u)) := pow_two_mul h hdbl ℓ _
      _ = h (16 * (2 ^ (s + 1) * n + u) + 1) := id3 h hdbl htri _ hodd'
      _ = h (2 ^ (s + 1 + 4) * n + (16 * u + 1)) := by
          congr 1
          rw [hp4]
          ring
  · -- Case A, `c ≡ 1 (mod 3)`: `v = 2`
    obtain ⟨t, ht⟩ : ∃ t, 3 * t + 1 = 4 * c := ⟨(4 * c - 1) / 3, by omega⟩
    have htodd : Odd t := Nat.odd_iff.mpr (by omega)
    refine ⟨a + 2, t, by omega, by omega, by omega, fun n => ?_⟩
    have hodd' : Odd (2 ^ (a + 2) * n + t) := by
      have : Even (2 ^ (a + 2) * n) := ⟨2 ^ (a + 1) * n, by rw [pow_succ]; ring⟩
      exact this.add_odd htodd
    calc h (2 ^ a * (3 * n + j) + r) = h (3 * (2 ^ a * n) + c) := by rw [key]
      _ = h (2 ^ 2 * (3 * (2 ^ a * n) + c)) := (pow_two_mul h hdbl 2 _).symm
      _ = h (3 * (2 ^ (a + 2) * n + t) + 1) := by
          congr 1
          rw [show 3 * (2 ^ (a + 2) * n + t) + 1 = 3 * (2 ^ (a + 2) * n) + (3 * t + 1) by ring, ht]
          ring
      _ = h (2 ^ (a + 2) * n + t) := tri' h hdbl htri _ hodd'
  · -- Case A, `c ≡ 2 (mod 3)`: `v = 1`
    obtain ⟨t, ht⟩ : ∃ t, 3 * t + 1 = 2 * c := ⟨(2 * c - 1) / 3, by omega⟩
    have htodd : Odd t := Nat.odd_iff.mpr (by omega)
    refine ⟨a + 1, t, by omega, by omega, by omega, fun n => ?_⟩
    have hodd' : Odd (2 ^ (a + 1) * n + t) := by
      have : Even (2 ^ (a + 1) * n) := ⟨2 ^ a * n, by rw [pow_succ]; ring⟩
      exact this.add_odd htodd
    calc h (2 ^ a * (3 * n + j) + r) = h (3 * (2 ^ a * n) + c) := by rw [key]
      _ = h (2 * (3 * (2 ^ a * n) + c)) := (hdbl _).symm
      _ = h (3 * (2 ^ (a + 1) * n + t) + 1) := by
          congr 1
          rw [show 3 * (2 ^ (a + 1) * n + t) + 1 = 3 * (2 ^ (a + 1) * n) + (3 * t + 1) by ring, ht]
          ring
      _ = h (2 ^ (a + 1) * n + t) := tri' h hdbl htri _ hodd'

/-- The two worked examples of V004 §3: `h (12n+5) = h (8n+3)` and `h (12n+3) = h (64n+17)`. -/
theorem example_12n5 (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + 1) = h n) (n : ℕ) :
    h (12 * n + 5) = h (8 * n + 3) := by
  have := tri' h hdbl htri (8 * n + 3) ⟨4 * n + 1, by ring⟩
  rw [show 3 * (8 * n + 3) + 1 = 2 * (12 * n + 5) by ring, hdbl] at this
  exact this

theorem example_12n3 (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + 1) = h n) (n : ℕ) :
    h (12 * n + 3) = h (64 * n + 17) := by
  have := id3 h hdbl htri (4 * n + 1) ⟨2 * n, by ring⟩
  rw [show 3 * (4 * n + 1) = 12 * n + 3 by ring, show 16 * (4 * n + 1) + 1 = 64 * n + 17 by ring] at this
  exact this

end Kernel
end LeanLane

/-!
# V004-iii — Assembly: binary-automatic Collatz-invariant colourings are constant,
modulo Cobham's theorem

This part is concatenated after `OddEventuallyPeriodic.lean` (V004-i) and
`KernelClosure.lean` (V004-ii) by `build_assembly.sh` into `V004_Assembly.lean`,
the file that is actually compiled.

Definitions. `Kernel k f` is the `k`-kernel of `f : ℕ → α`, the set of
sections `n ↦ f (k^e n + j)` with `j < k^e`; `KAutomatic k f` says it is
finite (Eilenberg's characterisation of `k`-automatic sequences, taken here
as the definition). `CobhamStatement α` is Cobham's theorem in this
formulation, quantified over **every** `f : ℕ → α`: a sequence with finite
2-kernel and finite 3-kernel is eventually periodic. It is the single
external input; it is not proved here and is not in Mathlib.
`finite_range_of_kernel2` records that a finite 2-kernel already forces a
finite range, so the hypothesis is the classical theorem for finite
alphabets and nothing stronger is being assumed.

Theorem `automatic_rigidity`: assuming `CobhamStatement α`, every `h : ℕ → α`
with `h (2n) = h n` for all `n`, `h (3n+1) = h n` for all odd `n > 1`, and
finite 2-kernel is constant on the positive integers. This is main's V004
theorem (`experiments/viewpoints/V004/GLOBAL_RIGIDITY.md`, §1) with its
external input made explicit in the hypotheses. No convergence statement is
involved.
-/

namespace LeanLane
namespace V004

variable {α : Type*}

/-- The `k`-kernel of `f`: all sections `n ↦ f (k^e n + j)` with `j < k^e`. -/
def Kernel (k : ℕ) (f : ℕ → α) : Set (ℕ → α) :=
  {g | ∃ e j : ℕ, j < k ^ e ∧ g = fun n => f (k ^ e * n + j)}

/-- Automaticity in base `k`, in Eilenberg's kernel formulation. -/
def KAutomatic (k : ℕ) (f : ℕ → α) : Prop := (Kernel k f).Finite

/-- **Cobham's theorem** (kernel form), as a named hypothesis quantified over every
sequence with values in `α`: finite 2-kernel and finite 3-kernel imply eventual
periodicity. -/
def CobhamStatement (α : Type*) : Prop :=
  ∀ f : ℕ → α, KAutomatic 2 f → KAutomatic 3 f →
    ∃ N M : ℕ, 0 < M ∧ ∀ n, N ≤ n → f (n + M) = f n

/-- A finite 2-kernel forces a finite range: `f m` is the value at `0` of the
section with `e = m`, `j = m`. -/
theorem finite_range_of_kernel2 (f : ℕ → α) (hK : KAutomatic 2 f) :
    (Set.range f).Finite := by
  apply (hK.image (fun g => g 0)).subset
  rintro _ ⟨m, rfl⟩
  exact ⟨fun n => f (2 ^ m * n + m), ⟨m, m, Nat.lt_two_pow_self, rfl⟩, by simp⟩

/-- V004's positive-offset family `K₊`. -/
def Kplus (h : ℕ → α) : Set (ℕ → α) :=
  {g | ∃ a r : ℕ, 1 ≤ a ∧ 0 < r ∧ r < 2 ^ a ∧ g = fun n => h (2 ^ a * n + r)}

theorem Kplus_subset_kernel (h : ℕ → α) : Kplus h ⊆ Kernel 2 h := by
  rintro g ⟨a, r, -, -, hr, rfl⟩
  exact ⟨a, r, hr, rfl⟩

/-- The 2-kernel of the odd restriction `b n = h (2n+1)` lies in the 2-kernel of `h`. -/
theorem kernel2_b_subset (h : ℕ → α) :
    Kernel 2 (fun n => h (2 * n + 1)) ⊆ Kernel 2 h := by
  rintro g ⟨e, j, hj, rfl⟩
  refine ⟨e + 1, 2 * j + 1, ?_, funext fun n => ?_⟩
  · rw [pow_succ]
    omega
  · show h (2 * (2 ^ e * n + j) + 1) = h (2 ^ (e + 1) * n + (2 * j + 1))
    congr 1
    rw [pow_succ]
    ring

/-- Every iterated ternary section of `b` is a positive-offset section of `h`
(induction on the number of ternary digits, using `kernel_ternary_closure`). -/
theorem b_sections (h : ℕ → α) (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + 1) = h n) :
    ∀ e j, j < 3 ^ e → ∃ a r, 1 ≤ a ∧ 0 < r ∧ r < 2 ^ a ∧
      ∀ n, h (2 * (3 ^ e * n + j) + 1) = h (2 ^ a * n + r) := by
  intro e
  induction e with
  | zero =>
    intro j hj
    have hj0 : j = 0 := by simpa using hj
    subst hj0
    exact ⟨1, 1, le_rfl, by norm_num, by norm_num, fun n => by congr 1; ring⟩
  | succ e ih =>
    intro j hj
    have hj3 : j < 3 ^ e * 3 := by rw [← pow_succ]; exact hj
    obtain ⟨q, m, hqm, hq3, hm⟩ : ∃ q m, j = 3 ^ e * q + m ∧ q < 3 ∧ m < 3 ^ e :=
      ⟨j / 3 ^ e, j % 3 ^ e, (Nat.div_add_mod j (3 ^ e)).symm, Nat.div_lt_of_lt_mul hj3,
        Nat.mod_lt _ (by positivity)⟩
    subst hqm
    obtain ⟨a, r, ha, hr0, hr, hsec⟩ := ih m hm
    obtain ⟨a', r', ha', hr0', hr', hcl⟩ :=
      Kernel.kernel_ternary_closure h hdbl htri ha hr0 hr hq3
    refine ⟨a', r', ha', hr0', hr', fun n => ?_⟩
    rw [show 3 ^ (e + 1) * n + (3 ^ e * q + m) = 3 ^ e * (3 * n + q) + m by rw [pow_succ]; ring,
      hsec (3 * n + q)]
    exact hcl n

/-- The 3-kernel of `b` lies in `K₊`. -/
theorem kernel3_b_subset (h : ℕ → α) (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + 1) = h n) :
    Kernel 3 (fun n => h (2 * n + 1)) ⊆ Kplus h := by
  rintro g ⟨e, j, hj, rfl⟩
  obtain ⟨a, r, ha, hr0, hr, hsec⟩ := b_sections h hdbl htri e j hj
  exact ⟨a, r, ha, hr0, hr, funext fun n => hsec n⟩

/-- **Binary-automatic rigidity (V004), modulo Cobham.** Assuming Cobham's theorem
for sequences in `α`, every colouring with `h (2n) = h n`, `h (3n+1) = h n` at odd
`n > 1`, and finite 2-kernel is constant on the positive integers. -/
theorem automatic_rigidity (cobham : CobhamStatement α) (h : ℕ → α)
    (hdbl : ∀ n, h (2 * n) = h n) (htri : ∀ n, Odd n → 1 < n → h (3 * n + 1) = h n)
    (hK : KAutomatic 2 h) : ∀ n, 0 < n → h n = h 1 := by
  have hb2 : KAutomatic 2 (fun n => h (2 * n + 1)) := hK.subset (kernel2_b_subset h)
  have hb3 : KAutomatic 3 (fun n => h (2 * n + 1)) :=
    (hK.subset (Kplus_subset_kernel h)).subset (kernel3_b_subset h hdbl htri)
  obtain ⟨N, M, hM, hev⟩ := cobham _ hb2 hb3
  exact OddEP.odd_eventually_periodic_const h hdbl htri hM hev

end V004
end LeanLane


/-!
# The scalar interface of invariant colourings (main's V005 §2)

Lane: `claude/lean-lane`. Prose source: `experiments/viewpoints/V005/scalar_interface.md`
on main ("Three scalar identities retain the complete Collatz guard").

Setting. A *colouring* `h : ℕ → α` is *invariant* when `h(2n) = h(n)` for all `n`
and `h(3n+1) = h(n)` for odd `n > 1`. Its *scalar* (odd-value) sequence is
`b(n) = h(2n+1)`. Conversely, from any sequence `b` main defines the odd-part
extension `h(x) = b((oddpart x − 1)/2)`, here `ext b`.

Verified in this file (all with the standard axioms):

* `ext_two_mul`, `ext_two_mul_add_one`, `ext_zero`, `ext_one`: for every `b`,
  `h = ext b` satisfies `h(2n) = h(n)`, `h(2n+1) = b(n)` and `h(0) = h(1) = b(0)`;
* `ext_tri_iff` (**main's equivalence**): `ext b` satisfies the remaining rule
  `h(3n+1) = h(n)` for odd `n > 1` **iff** `b` satisfies the three identities
  `b(3n) = b(4n)`, `b(3n+2) = b(2n+1)`, `b(4n+2) = b(n)` for all `n ≥ 0`.
  The converse goes through `ext_three_mul_add_two` (`h(3m+2) = b(m)`, main's
  `E(m)`, by strong induction on `m` with the split `m` odd / `4l` / `4l+2`);
  the rule then even holds for every odd `n`, including `n = 1` (`ext_tri`);
* `scalar_interface_iff`: `b` satisfies the three identities iff it is the
  scalar sequence of some invariant colouring;
* `ext_odd_values`: for an invariant colouring `h` (only `h(2n) = h(n)` is
  used), `ext (n ↦ h(2n+1)) x = h x` for every `x > 0` — so, together with
  `ext_two_mul_add_one`, the two passages are mutually inverse on the positive
  integers;
* `v004_relation`: the additional V004 relation `b(3n+1) = b(16n+8)` follows
  from the colouring rules, as the prose notes.

Nothing here concerns orbits, kernels, growth or convergence; Collatz remains
open.
-/

namespace LeanLane
namespace Scalar

variable {α : Type*}

/-! ### The odd part -/

/-- The odd part of `n`: `n / 2^{v₂(n)}`, with `oddPart 0 = 0`. -/
def oddPart (n : ℕ) : ℕ := n / 2 ^ padicValNat 2 n

theorem oddPart_zero : oddPart 0 = 0 := by simp [oddPart]

theorem oddPart_two_mul (n : ℕ) : oddPart (2 * n) = oddPart n := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simp [oddPart]
  · unfold oddPart
    rw [padicValNat.mul (by norm_num) hn.ne', padicValNat.self (by norm_num), pow_add, pow_one,
      Nat.mul_div_mul_left _ _ (by norm_num : 0 < 2)]

theorem oddPart_odd {n : ℕ} (hn : Odd n) : oddPart n = n := by
  unfold oddPart
  have h2 : ¬ 2 ∣ n := by obtain ⟨k, hk⟩ := hn; omega
  rw [padicValNat.eq_zero_of_not_dvd h2, pow_zero, Nat.div_one]

theorem oddPart_odd_of_pos : ∀ x, 0 < x → Odd (oddPart x) := by
  intro x
  induction x using Nat.strong_induction_on with
  | _ x ih =>
    intro hx
    rcases Nat.even_or_odd x with ⟨y, hy⟩ | hodd
    · have hx2 : x = 2 * y := by omega
      subst hx2
      rw [oddPart_two_mul]
      exact ih y (by omega) (by omega)
    · rw [oddPart_odd hodd]
      exact hodd

/-- A colouring with `h(2n) = h(n)` is determined by its values at odd arguments. -/
theorem colouring_oddPart (h : ℕ → α) (hdbl : ∀ n, h (2 * n) = h n) :
    ∀ x, 0 < x → h (oddPart x) = h x := by
  intro x
  induction x using Nat.strong_induction_on with
  | _ x ih =>
    intro hx
    rcases Nat.even_or_odd x with ⟨y, hy⟩ | hodd
    · have hx2 : x = 2 * y := by omega
      subst hx2
      rw [oddPart_two_mul, hdbl]
      exact ih y (by omega) (by omega)
    · rw [oddPart_odd hodd]

/-! ### The odd-part extension of a sequence -/

/-- Main's extension: `h(x) = b((oddpart x − 1)/2)`; in particular `h(2n+1) = b(n)`. -/
def ext (b : ℕ → α) (x : ℕ) : α := b ((oddPart x - 1) / 2)

theorem ext_zero (b : ℕ → α) : ext b 0 = b 0 := by simp [ext, oddPart]

theorem ext_one (b : ℕ → α) : ext b 1 = b 0 := by simp [ext, oddPart_odd odd_one]

theorem ext_two_mul (b : ℕ → α) (n : ℕ) : ext b (2 * n) = ext b n := by
  unfold ext
  rw [oddPart_two_mul]

theorem ext_two_mul_add_one (b : ℕ → α) (n : ℕ) : ext b (2 * n + 1) = b n := by
  unfold ext
  rw [oddPart_odd ⟨n, rfl⟩]
  congr 1
  omega

/-- Main's `E(m)`: under the three identities, `h(3m+2) = b(m)` for every `m`. -/
theorem ext_three_mul_add_two (b : ℕ → α)
    (h1 : ∀ n, b (3 * n) = b (4 * n))
    (h2 : ∀ n, b (3 * n + 2) = b (2 * n + 1))
    (h3 : ∀ n, b (4 * n + 2) = b n) :
    ∀ m, ext b (3 * m + 2) = b m := by
  intro m
  induction m using Nat.strong_induction_on with
  | _ m ih =>
    rcases Nat.even_or_odd m with ⟨k, hk⟩ | ⟨k, hk⟩
    · rcases Nat.even_or_odd k with ⟨l, hl⟩ | ⟨l, hl⟩
      · -- `m = 4l`: `h(12l+2) = h(6l+1) = b(3l) = b(4l)` by the first identity
        have hm : m = 4 * l := by omega
        subst hm
        rw [show 3 * (4 * l) + 2 = 2 * (2 * (3 * l) + 1) by ring, ext_two_mul,
          ext_two_mul_add_one]
        exact h1 l
      · -- `m = 4l+2`: `h(12l+8) = h(3l+2) = b(l) = b(4l+2)` by induction and the third
        have hm : m = 4 * l + 2 := by omega
        subst hm
        rw [show 3 * (4 * l + 2) + 2 = 2 * (2 * (3 * l + 2)) by ring, ext_two_mul, ext_two_mul,
          ih l (by omega)]
        exact (h3 l).symm
    · -- `m = 2k+1`: `h(6k+5) = b(3k+2) = b(2k+1)` by the second identity
      have hm : m = 2 * k + 1 := by omega
      subst hm
      rw [show 3 * (2 * k + 1) + 2 = 2 * (3 * k + 2) + 1 by ring, ext_two_mul_add_one]
      exact h2 k

/-- Under the three identities the extension satisfies the odd rule at **every** odd
`n`, including `n = 1`. -/
theorem ext_tri (b : ℕ → α)
    (h1 : ∀ n, b (3 * n) = b (4 * n))
    (h2 : ∀ n, b (3 * n + 2) = b (2 * n + 1))
    (h3 : ∀ n, b (4 * n + 2) = b n) :
    ∀ n, Odd n → ext b (3 * n + 1) = ext b n := by
  rintro n ⟨m, rfl⟩
  rw [show 3 * (2 * m + 1) + 1 = 2 * (3 * m + 2) by ring, ext_two_mul,
    ext_three_mul_add_two b h1 h2 h3 m, ext_two_mul_add_one]

/-! ### The three identities from the colouring rules (V004 algebra) -/

theorem odd_rule_two_mul_add_one (h : ℕ → α) (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + 1) = h n) (n : ℕ) :
    h (2 * n + 1) = h (3 * n + 2) := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · have h21 : h 2 = h 1 := by simpa using hdbl 1
    simpa using h21.symm
  · have := htri (2 * n + 1) ⟨n, rfl⟩ (by omega)
    rw [show 3 * (2 * n + 1) + 1 = 2 * (3 * n + 2) by ring, hdbl] at this
    exact this.symm

/-- `b(3n) = b(4n)`, i.e. `h(6n+1) = h(8n+1)`. -/
theorem id1_of_colouring (h : ℕ → α) (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + 1) = h n) (n : ℕ) :
    h (2 * (3 * n) + 1) = h (2 * (4 * n) + 1) := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simp
  · have := htri (8 * n + 1) ⟨4 * n, by ring⟩ (by omega)
    rw [show 3 * (8 * n + 1) + 1 = 2 * (2 * (6 * n + 1)) by ring, hdbl, hdbl] at this
    rw [show 2 * (3 * n) + 1 = 6 * n + 1 by ring, show 2 * (4 * n) + 1 = 8 * n + 1 by ring]
    exact this

/-- `b(3n+2) = b(2n+1)`, i.e. `h(6n+5) = h(4n+3)`. -/
theorem id2_of_colouring (h : ℕ → α) (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + 1) = h n) (n : ℕ) :
    h (2 * (3 * n + 2) + 1) = h (2 * (2 * n + 1) + 1) := by
  have := htri (4 * n + 3) ⟨2 * n + 1, by ring⟩ (by omega)
  rw [show 3 * (4 * n + 3) + 1 = 2 * (6 * n + 5) by ring, hdbl] at this
  rw [show 2 * (3 * n + 2) + 1 = 6 * n + 5 by ring, show 2 * (2 * n + 1) + 1 = 4 * n + 3 by ring]
  exact this

/-- `b(4n+2) = b(n)`, i.e. `h(8n+5) = h(2n+1)`. -/
theorem id3_of_colouring (h : ℕ → α) (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + 1) = h n) (n : ℕ) :
    h (2 * (4 * n + 2) + 1) = h (2 * n + 1) := by
  have := htri (8 * n + 5) ⟨4 * n + 2, by ring⟩ (by omega)
  rw [show 3 * (8 * n + 5) + 1 = 2 * (2 * (2 * (3 * n + 2))) by ring, hdbl, hdbl, hdbl] at this
  rw [show 2 * (4 * n + 2) + 1 = 8 * n + 5 by ring]
  exact this.symm.trans (odd_rule_two_mul_add_one h hdbl htri n).symm

/-- The additional V004 relation `b(3n+1) = b(16n+8)` follows from the colouring rules. -/
theorem v004_relation (h : ℕ → α) (hdbl : ∀ n, h (2 * n) = h n)
    (htri : ∀ n, Odd n → 1 < n → h (3 * n + 1) = h n) (n : ℕ) :
    h (2 * (3 * n + 1) + 1) = h (2 * (16 * n + 8) + 1) := by
  have hA := htri (32 * n + 17) ⟨16 * n + 8, by ring⟩ (by omega)
  rw [show 3 * (32 * n + 17) + 1 = 2 * (2 * (24 * n + 13)) by ring, hdbl, hdbl] at hA
  have hB := htri (24 * n + 13) ⟨12 * n + 6, by ring⟩ (by omega)
  rw [show 3 * (24 * n + 13) + 1 = 2 * (2 * (2 * (9 * n + 5))) by ring, hdbl, hdbl, hdbl] at hB
  have hC := htri (6 * n + 3) ⟨3 * n + 1, by ring⟩ (by omega)
  rw [show 3 * (6 * n + 3) + 1 = 2 * (9 * n + 5) by ring, hdbl] at hC
  rw [show 2 * (3 * n + 1) + 1 = 6 * n + 3 by ring,
    show 2 * (16 * n + 8) + 1 = 32 * n + 17 by ring]
  exact hC.symm.trans (hB.trans hA)

/-! ### The equivalence -/

/-- **Main's V005 §2 equivalence.** For any sequence `b`, the odd-part extension
`h = ext b` (which always has `h(2n) = h(n)`, `h(2n+1) = b(n)`, `h(0) = h(1)`)
satisfies the remaining invariant rule `h(3n+1) = h(n)` at every odd `n > 1` iff
`b` satisfies the three scalar identities for all `n ≥ 0`. -/
theorem ext_tri_iff (b : ℕ → α) :
    (∀ n, Odd n → 1 < n → ext b (3 * n + 1) = ext b n) ↔
      (∀ n, b (3 * n) = b (4 * n)) ∧ (∀ n, b (3 * n + 2) = b (2 * n + 1)) ∧
        (∀ n, b (4 * n + 2) = b n) := by
  constructor
  · intro htri
    refine ⟨fun n => ?_, fun n => ?_, fun n => ?_⟩
    · have := id1_of_colouring (ext b) (ext_two_mul b) htri n
      rwa [ext_two_mul_add_one, ext_two_mul_add_one] at this
    · have := id2_of_colouring (ext b) (ext_two_mul b) htri n
      rwa [ext_two_mul_add_one, ext_two_mul_add_one] at this
    · have := id3_of_colouring (ext b) (ext_two_mul b) htri n
      rwa [ext_two_mul_add_one, ext_two_mul_add_one] at this
  · rintro ⟨h1, h2, h3⟩ n hn _
    exact ext_tri b h1 h2 h3 n hn

/-- **The scalar interface.** A sequence `b` satisfies the three identities iff it
is the odd-value sequence `n ↦ h(2n+1)` of some invariant colouring `h`. -/
theorem scalar_interface_iff (b : ℕ → α) :
    ((∀ n, b (3 * n) = b (4 * n)) ∧ (∀ n, b (3 * n + 2) = b (2 * n + 1)) ∧
        (∀ n, b (4 * n + 2) = b n)) ↔
      ∃ h : ℕ → α, (∀ n, h (2 * n) = h n) ∧ (∀ n, Odd n → 1 < n → h (3 * n + 1) = h n) ∧
        ∀ n, h (2 * n + 1) = b n := by
  constructor
  · intro hb
    exact ⟨ext b, ext_two_mul b, (ext_tri_iff b).mpr hb, ext_two_mul_add_one b⟩
  · rintro ⟨h, hdbl, htri, hb⟩
    refine ⟨fun n => ?_, fun n => ?_, fun n => ?_⟩
    · have := id1_of_colouring h hdbl htri n
      rwa [hb, hb] at this
    · have := id2_of_colouring h hdbl htri n
      rwa [hb, hb] at this
    · have := id3_of_colouring h hdbl htri n
      rwa [hb, hb] at this

/-- The passage `h ↦ (n ↦ h(2n+1)) ↦ ext` recovers `h` on the positive integers (only
`h(2n) = h(n)` is used); with `ext_two_mul_add_one` the two passages are inverse. -/
theorem ext_odd_values (h : ℕ → α) (hdbl : ∀ n, h (2 * n) = h n) (x : ℕ) (hx : 0 < x) :
    ext (fun n => h (2 * n + 1)) x = h x := by
  obtain ⟨k, hk⟩ := oddPart_odd_of_pos x hx
  have e : 2 * ((oddPart x - 1) / 2) + 1 = oddPart x := by omega
  show h (2 * ((oddPart x - 1) / 2) + 1) = h x
  rw [e, colouring_oddPart h hdbl x hx]

end Scalar
end LeanLane

/-!
# V007-a — Reverse closure: for a scalar sequence, binary and ternary automaticity
coincide, and either forces constancy modulo Cobham's theorem

This part is concatenated after `V004_Assembly.lean` (V004-i/ii/iii) and
`ScalarInterface.lean` (V005-a) by `build_reverse_assembly.sh` into
`ReverseClosure_Assembly.lean`, the file that is actually compiled.

Prose source: main's `experiments/viewpoints/V007/separator.md` §1.1 and
`affine_growth.md` §3 ("reverse closure"). Throughout, `b : ℕ → α` satisfies the
three scalar identities `b(3n) = b(4n)`, `b(3n+2) = b(2n+1)`, `b(4n+2) = b(n)`
(V005's interface), and `c(n) = b(2n)`.

* `kernel3_c_finite`: a finite 3-kernel of `b` gives a finite 3-kernel of `c`
  (`c(3^a n + r) = f(2n + q)` for a ternary section `f` of `b`, `q ∈ {0,1}`);
* `union_binary_closed`: `K₃(b) ∪ K₃(c)` is closed under both binary sections —
  the four displayed cases of V007 §1.1, one scalar identity each;
* `kernel2_subset_union`, `binary_automatic_of_ternary`: hence `K₂(b) ⊆ K₃(b) ∪ K₃(c)`
  and a 3-automatic `b` is 2-automatic;
* `kernel2_ext_subset`, `ext_automatic_of_automatic`: `K₂(ext b) ⊆ {ext b} ∪ K₂(b)`
  (V005's `K_D(h) = {h} ∪ K_{D−1}(b)` without the depth bookkeeping);
* `ternary_automatic_of_binary`, `automatic_two_iff_three`: the converse through
  V004's `K₃(b) ⊆ K₊(ext b) ⊆ K₂(ext b)`; so for a scalar sequence of an invariant
  colouring, **2-automatic ⇔ 3-automatic**, with no external input;
* `constant_of_ternary_automatic`: assuming `CobhamStatement α`, a 3-automatic `b`
  with the three identities is constant, `b n = b 0` (via `automatic_rigidity`).

Not formalised: V005's reconstruction of `b` from an arbitrary positive binary
section `g` of `h` (so the statements here are about `b` itself, which is V007's
first paragraph of §1.1), and the singleton-exit theorem (V007-b). No convergence
statement is involved.
-/

namespace LeanLane
namespace RevClos

open V004

variable {α : Type*}

/-- `c(n) = b(2n)`. -/
def c (b : ℕ → α) : ℕ → α := fun n => b (2 * n)

/-- Every ternary section of `c` is `n ↦ f (2n + q)`, `q ∈ {0,1}`, for a ternary
section `f` of `b`: write `2r = q·3^e + s`. -/
theorem kernel3_c_subset (b : ℕ → α) :
    Kernel 3 (c b) ⊆
      (fun p : (ℕ → α) × ℕ => fun n => p.1 (2 * n + p.2)) ''
        (Kernel 3 b ×ˢ ({0, 1} : Set ℕ)) := by
  rintro g ⟨e, r, hr, rfl⟩
  have hq : 2 * r / 3 ^ e < 2 := Nat.div_lt_of_lt_mul (by omega)
  refine ⟨(fun n => b (3 ^ e * n + 2 * r % 3 ^ e), 2 * r / 3 ^ e),
    ⟨⟨e, 2 * r % 3 ^ e, Nat.mod_lt _ (by positivity), rfl⟩, ?_⟩, ?_⟩
  · rcases Nat.le_one_iff_eq_zero_or_eq_one.mp (Nat.lt_succ_iff.mp hq) with h0 | h1
    · rw [h0]; simp
    · rw [h1]; simp
  · funext n
    show b (3 ^ e * (2 * n + 2 * r / 3 ^ e) + 2 * r % 3 ^ e) = b (2 * (3 ^ e * n + r))
    congr 1
    have hdm := Nat.div_add_mod (2 * r) (3 ^ e)
    calc 3 ^ e * (2 * n + 2 * r / 3 ^ e) + 2 * r % 3 ^ e
        = 3 ^ e * (2 * n) + (3 ^ e * (2 * r / 3 ^ e) + 2 * r % 3 ^ e) := by ring
      _ = 3 ^ e * (2 * n) + 2 * r := by rw [hdm]
      _ = 2 * (3 ^ e * n + r) := by ring

theorem kernel3_c_finite (b : ℕ → α) (hb : KAutomatic 3 b) : KAutomatic 3 (c b) :=
  ((hb.prod ((Set.finite_singleton 1).insert 0)).image _).subset (kernel3_c_subset b)

/-- **V007 §1.1, the four cases.** Binary sections of `K₃(b) ∪ K₃(c)` stay in the union:
with `v = 3^a i + r = 2w` or `2w+1`, the section of `b(3^a n + r)` is `c(3^a n + w)` or
`b(3^(a+1) n + 3w + 2)`, and the section of `c(3^a n + r)` is `b(3^(a+1) n + 3w)` or
`b(3^a n + w)`. -/
theorem union_binary_closed (b : ℕ → α)
    (I1 : ∀ n, b (3 * n) = b (4 * n)) (I2 : ∀ n, b (3 * n + 2) = b (2 * n + 1))
    (I3 : ∀ n, b (4 * n + 2) = b n) :
    ∀ g ∈ Kernel 3 b ∪ Kernel 3 (c b), ∀ i, i < 2 →
      (fun n => g (2 * n + i)) ∈ Kernel 3 b ∪ Kernel 3 (c b) := by
  rintro g (⟨a, r, hr, rfl⟩ | ⟨a, r, hr, rfl⟩) i hi
  · have hi' : 3 ^ a * i ≤ 3 ^ a := by
      calc 3 ^ a * i ≤ 3 ^ a * 1 := Nat.mul_le_mul_left _ (by omega)
        _ = 3 ^ a := mul_one _
    rcases Nat.even_or_odd (3 ^ a * i + r) with ⟨w, hw⟩ | ⟨w, hw⟩
    · -- `v = 2w`: a ternary section of `c` at offset `w`
      right
      refine ⟨a, w, by omega, funext fun n => ?_⟩
      show b (3 ^ a * (2 * n + i) + r) = b (2 * (3 ^ a * n + w))
      congr 1
      calc 3 ^ a * (2 * n + i) + r = 2 * (3 ^ a * n) + (3 ^ a * i + r) := by ring
        _ = 2 * (3 ^ a * n) + (w + w) := by rw [hw]
        _ = 2 * (3 ^ a * n + w) := by ring
    · -- `v = 2w+1`: `b(2m+1) = b(3m+2)` gives depth `a+1`, offset `3w+2`
      left
      refine ⟨a + 1, 3 * w + 2, by rw [pow_succ]; omega, funext fun n => ?_⟩
      show b (3 ^ a * (2 * n + i) + r) = b (3 ^ (a + 1) * n + (3 * w + 2))
      rw [show 3 ^ a * (2 * n + i) + r = 2 * (3 ^ a * n + w) + 1 by
          calc 3 ^ a * (2 * n + i) + r = 2 * (3 ^ a * n) + (3 ^ a * i + r) := by ring
            _ = 2 * (3 ^ a * n) + (2 * w + 1) := by rw [hw]
            _ = 2 * (3 ^ a * n + w) + 1 := by ring,
        ← I2, pow_succ]
      congr 1
      ring
  · have hi' : 3 ^ a * i ≤ 3 ^ a := by
      calc 3 ^ a * i ≤ 3 ^ a * 1 := Nat.mul_le_mul_left _ (by omega)
        _ = 3 ^ a := mul_one _
    rcases Nat.even_or_odd (3 ^ a * i + r) with ⟨w, hw⟩ | ⟨w, hw⟩
    · -- `v = 2w`: `b(4m) = b(3m)` gives depth `a+1`, offset `3w`
      left
      refine ⟨a + 1, 3 * w, by rw [pow_succ]; omega, funext fun n => ?_⟩
      show b (2 * (3 ^ a * (2 * n + i) + r)) = b (3 ^ (a + 1) * n + 3 * w)
      rw [show 2 * (3 ^ a * (2 * n + i) + r) = 4 * (3 ^ a * n + w) by
          calc 2 * (3 ^ a * (2 * n + i) + r) = 4 * (3 ^ a * n) + 2 * (3 ^ a * i + r) := by ring
            _ = 4 * (3 ^ a * n) + 2 * (w + w) := by rw [hw]
            _ = 4 * (3 ^ a * n + w) := by ring,
        ← I1, pow_succ]
      congr 1
      ring
    · -- `v = 2w+1`: `b(4m+2) = b(m)` gives depth `a`, offset `w`
      left
      refine ⟨a, w, by omega, funext fun n => ?_⟩
      show b (2 * (3 ^ a * (2 * n + i) + r)) = b (3 ^ a * n + w)
      rw [show 2 * (3 ^ a * (2 * n + i) + r) = 4 * (3 ^ a * n + w) + 2 by
          calc 2 * (3 ^ a * (2 * n + i) + r) = 4 * (3 ^ a * n) + 2 * (3 ^ a * i + r) := by ring
            _ = 4 * (3 ^ a * n) + 2 * (2 * w + 1) := by rw [hw]
            _ = 4 * (3 ^ a * n + w) + 2 := by ring,
        I3]

/-- The binary kernel of `b` lies in `K₃(b) ∪ K₃(c)` (induction on the binary depth,
peeling the most significant digit). -/
theorem kernel2_subset_union (b : ℕ → α)
    (I1 : ∀ n, b (3 * n) = b (4 * n)) (I2 : ∀ n, b (3 * n + 2) = b (2 * n + 1))
    (I3 : ∀ n, b (4 * n + 2) = b n) :
    Kernel 2 b ⊆ Kernel 3 b ∪ Kernel 3 (c b) := by
  rintro g ⟨e, j, hj, rfl⟩
  induction e generalizing j with
  | zero =>
    have hj0 : j = 0 := by rw [pow_zero] at hj; omega
    subst hj0
    left
    exact ⟨0, 0, by norm_num, funext fun n => by simp⟩
  | succ e ih =>
    have hj2 : j < 2 ^ e * 2 := by rw [← pow_succ]; exact hj
    have hi : j / 2 ^ e < 2 := Nat.div_lt_of_lt_mul hj2
    have hj' : j % 2 ^ e < 2 ^ e := Nat.mod_lt _ (by positivity)
    have key : (fun n => b (2 ^ (e + 1) * n + j)) =
        fun n => (fun m => b (2 ^ e * m + j % 2 ^ e)) (2 * n + j / 2 ^ e) := by
      funext n
      show b (2 ^ (e + 1) * n + j) = b (2 ^ e * (2 * n + j / 2 ^ e) + j % 2 ^ e)
      congr 1
      have hdm := Nat.div_add_mod j (2 ^ e)
      calc 2 ^ (e + 1) * n + j = 2 ^ e * (2 * n) + j := by ring
        _ = 2 ^ e * (2 * n) + (2 ^ e * (j / 2 ^ e) + j % 2 ^ e) := by rw [hdm]
        _ = 2 ^ e * (2 * n + j / 2 ^ e) + j % 2 ^ e := by ring
    rw [key]
    exact union_binary_closed b I1 I2 I3 _ (ih _ hj') _ hi

/-- **Reverse closure (V007 §1.1).** A 3-automatic scalar sequence is 2-automatic. -/
theorem binary_automatic_of_ternary (b : ℕ → α)
    (I1 : ∀ n, b (3 * n) = b (4 * n)) (I2 : ∀ n, b (3 * n + 2) = b (2 * n + 1))
    (I3 : ∀ n, b (4 * n + 2) = b n) (hb : KAutomatic 3 b) : KAutomatic 2 b :=
  (hb.union (kernel3_c_finite b hb)).subset (kernel2_subset_union b I1 I2 I3)

/-! ### The binary kernel of the odd-part extension -/

theorem ext_pow_two_mul (b : ℕ → α) (v x : ℕ) :
    Scalar.ext b (2 ^ v * x) = Scalar.ext b x := by
  induction v with
  | zero => simp
  | succ v ih => rw [pow_succ, mul_comm (2 ^ v) 2, mul_assoc, Scalar.ext_two_mul, ih]

/-- `K₂(ext b) ⊆ {ext b} ∪ K₂(b)`: a zero offset gives `ext b` itself, and a positive
offset `2^v (2j'+1)` at depth `v + k + 1` gives the section of `b` at depth `k`,
offset `j'`. -/
theorem kernel2_ext_subset (b : ℕ → α) :
    Kernel 2 (Scalar.ext b) ⊆ {Scalar.ext b} ∪ Kernel 2 b := by
  rintro g ⟨e, j, hj, rfl⟩
  rcases Nat.eq_zero_or_pos j with rfl | hj0
  · left
    show (fun n => Scalar.ext b (2 ^ e * n + 0)) = Scalar.ext b
    funext n
    rw [add_zero, ext_pow_two_mul]
  · right
    obtain ⟨v, m, hm2, rfl⟩ := Nat.exists_eq_pow_mul_and_not_dvd hj0.ne' 2 (by norm_num)
    obtain ⟨j', rfl⟩ : Odd m := Nat.not_even_iff_odd.mp (fun he => hm2 (even_iff_two_dvd.mp he))
    have hve : v < e := by
      rcases Nat.lt_or_ge v e with hve | hle
      · exact hve
      · exfalso
        have h1 := Nat.pow_le_pow_right (by norm_num : 0 < 2) hle
        have h2 := Nat.le_mul_of_pos_right (2 ^ v) (by omega : 0 < 2 * j' + 1)
        omega
    obtain ⟨k, rfl⟩ : ∃ k, e = v + k + 1 := ⟨e - v - 1, by omega⟩
    have hjk : j' < 2 ^ k := by
      have hlt : 2 ^ v * (2 * j' + 1) < 2 ^ v * (2 * 2 ^ k) := by
        calc 2 ^ v * (2 * j' + 1) < 2 ^ (v + k + 1) := hj
          _ = 2 ^ v * (2 * 2 ^ k) := by ring
      have := Nat.lt_of_mul_lt_mul_left hlt
      omega
    refine ⟨k, j', hjk, funext fun n => ?_⟩
    show Scalar.ext b (2 ^ (v + k + 1) * n + 2 ^ v * (2 * j' + 1)) = b (2 ^ k * n + j')
    rw [show 2 ^ (v + k + 1) * n + 2 ^ v * (2 * j' + 1) = 2 ^ v * (2 * (2 ^ k * n + j') + 1) by
        ring,
      ext_pow_two_mul, Scalar.ext_two_mul_add_one]

theorem ext_automatic_of_automatic (b : ℕ → α) (hb : KAutomatic 2 b) :
    KAutomatic 2 (Scalar.ext b) :=
  ((Set.finite_singleton _).union hb).subset (kernel2_ext_subset b)

/-- The forward direction through V004: a 2-automatic scalar sequence of an invariant
colouring is 3-automatic (`K₃(b) ⊆ K₊(ext b) ⊆ K₂(ext b)`). -/
theorem ternary_automatic_of_binary (b : ℕ → α)
    (I1 : ∀ n, b (3 * n) = b (4 * n)) (I2 : ∀ n, b (3 * n + 2) = b (2 * n + 1))
    (I3 : ∀ n, b (4 * n + 2) = b n) (hb : KAutomatic 2 b) : KAutomatic 3 b := by
  have htri := (Scalar.ext_tri_iff b).mpr ⟨I1, I2, I3⟩
  have hK : KAutomatic 2 (Scalar.ext b) := ext_automatic_of_automatic b hb
  have hsub : Kernel 3 (fun n => Scalar.ext b (2 * n + 1)) ⊆ Kernel 2 (Scalar.ext b) :=
    (kernel3_b_subset (Scalar.ext b) (Scalar.ext_two_mul b) htri).trans
      (Kplus_subset_kernel _)
  have hfun : (fun n => Scalar.ext b (2 * n + 1)) = b := funext (Scalar.ext_two_mul_add_one b)
  rw [hfun] at hsub
  exact hK.subset hsub

/-- **Two-base symmetry.** For a scalar sequence satisfying the three identities,
binary and ternary automaticity coincide; no external theorem is used. -/
theorem automatic_two_iff_three (b : ℕ → α)
    (I1 : ∀ n, b (3 * n) = b (4 * n)) (I2 : ∀ n, b (3 * n + 2) = b (2 * n + 1))
    (I3 : ∀ n, b (4 * n + 2) = b n) : KAutomatic 2 b ↔ KAutomatic 3 b :=
  ⟨ternary_automatic_of_binary b I1 I2 I3, binary_automatic_of_ternary b I1 I2 I3⟩

/-- **V007 §1.1 consequence, modulo Cobham.** A 3-automatic scalar sequence with the
three identities is constant. -/
theorem constant_of_ternary_automatic (cobham : CobhamStatement α) (b : ℕ → α)
    (I1 : ∀ n, b (3 * n) = b (4 * n)) (I2 : ∀ n, b (3 * n + 2) = b (2 * n + 1))
    (I3 : ∀ n, b (4 * n + 2) = b n) (hb : KAutomatic 3 b) : ∀ n, b n = b 0 := by
  have htri := (Scalar.ext_tri_iff b).mpr ⟨I1, I2, I3⟩
  have hK := ext_automatic_of_automatic b (binary_automatic_of_ternary b I1 I2 I3 hb)
  have hconst := automatic_rigidity cobham (Scalar.ext b) (Scalar.ext_two_mul b) htri hK
  intro n
  have := hconst (2 * n + 1) (by omega)
  rwa [Scalar.ext_two_mul_add_one, Scalar.ext_one] at this

end RevClos
end LeanLane
